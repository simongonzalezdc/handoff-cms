CMS_POSTGRES_DB=cms
CMS_POSTGRES_USER=cms
CMS_POSTGRES_PASSWORD=replace-with-a-strong-database-password
CMS_DATABASE_URL=postgres://cms:replace-with-a-strong-database-password@postgres:5432/cms

CMS_MINIO_ROOT_USER=cms-root
CMS_MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-root-password
CMS_OBJECT_BUCKET=cms-content
CMS_OBJECT_ACCESS_KEY_ID=cms-app
CMS_OBJECT_SECRET_ACCESS_KEY=replace-with-a-distinct-strong-application-secret

CMS_PUBLIC_URL=http://127.0.0.1:8080
CMS_OIDC_ISSUER=https://identity.example.com
CMS_OIDC_AUDIENCE=handoff-cms
CMS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

CMS_BIND_HOST=127.0.0.1
CMS_BIND_PORT=8080
CMS_PORT=8080
CMS_DEFAULT_LOCALE=en
