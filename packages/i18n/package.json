{
  "name": "@cms/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free peer English and Spanish messages for the Handoff CMS authoring interface.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/i18n/test"
  },
  "devDependencies": {}
}
